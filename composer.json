{
    "name": "fused/telescope-livewire",
    "description": "Livewire watcher for Laravel Telescope.",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/telescope": "^4.0|^5.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Fused\\TelescopeLivewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fused\\TelescopeLivewire\\Tests\\": "tests/"
        }
    }
}